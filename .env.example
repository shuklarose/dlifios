# Copy this file to .env and fill in real values. .env is gitignored.

# Qdrant Cloud (Day 6) — cluster URL + API key from cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=

# Google AI Studio (Day 8) — Gemini API key from aistudio.google.com
GEMINI_API_KEY=

# Supabase (product phase 1) — from Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET — bypasses all Row Level Security. Server-only, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
