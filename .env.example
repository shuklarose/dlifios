# Copy to .env and fill in real values. .env is gitignored.

# Vector store. Cluster URL and API key from cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=

# Generation model. API key from aistudio.google.com
GEMINI_API_KEY=
# Generation model and sampling temperature. Both optional.
# Defaults: gemini-2.5-flash, temperature 0.
# The embedding model is deliberately NOT here: changing it invalidates the
# whole vector index and needs a full rebuild, so it lives in src/config.ts
# where that consequence is written down next to it.
GEMINI_MODEL=
GEMINI_TEMPERATURE=

# Supabase, from Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Bypasses all Row Level Security. Server-only, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anonymous questions per IP per 24h. Defaults to 3 if unset. Raise it locally,
# where the browser and any curl testing share one IP.
ANON_LIMIT=

# Shared secret for the machine routes: /ingest, /monitor, /digest. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset, those routes refuse every request rather than allowing them.
ADMIN_TOKEN=

# Comma-separated origins allowed to call this API from a browser. Needed only
# when the frontend is hosted separately from the API. Empty means same-origin
# only, which is the closed default.
#   ALLOWED_ORIGINS=https://your-frontend.example.com
ALLOWED_ORIGINS=

# Port the server listens on. Defaults to 3000.
PORT=
